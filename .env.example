# Copy this file to ".env" and fill in your keys. Never commit ".env".

PORT=3000

# --- Map (MapTiler) -------------------------------------------------------
# Get a free key: https://cloud.maptiler.com/account/keys/
# Leave empty to fall back to free OpenStreetMap tiles.
# This key is sent to the browser, so restrict it to your domain in the MapTiler dashboard.
MAPTILER_API_KEY=
MAPTILER_STYLE=streets-v2-dark

# Initial map view (defaults to Delhi, where the demo cameras are). For Chennai use 13.0827 / 80.2707.
MAP_CENTER_LAT=28.6080
MAP_CENTER_LNG=77.2090
MAP_ZOOM=12

# --- Gemini (AI investigator brief) ---------------------------------------
# Get a key: https://aistudio.google.com/apikey
# This key stays on the server and is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
